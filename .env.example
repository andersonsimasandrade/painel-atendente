# ═══════════════════════════════════════════════════════════════════════════
#  ATENDENTE 24h · PAINEL — variáveis de ambiente
# ═══════════════════════════════════════════════════════════════════════════
#
#  COMO USAR
#   • No seu computador: copie este arquivo para `.env.local` e preencha.
#   • Na VPS (EasyPanel/Docker) ou na Vercel: cole cada uma no painel de
#     "Environment Variables" do serviço.
#
#  NUNCA versione o arquivo preenchido. O .gitignore já bloqueia `.env*`
#  (deixando só este exemplo passar).
#
#  Para gerar um segredo aleatório:
#     openssl rand -hex 32
#  Sem o openssl, no PowerShell:
#     -join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })
#
#  NENHUMA variável aponta para outra instalação. Onde existe um padrão, ele é
#  neutro e está escrito aqui embaixo — não há endereço de banco, domínio nem
#  instância de terceiros escondidos no código. Quando falta uma variável
#  essencial, o painel diz o NOME dela na tela em vez de funcionar pela metade.
# ═══════════════════════════════════════════════════════════════════════════


# ── NÍVEL 1 · SEM ESTAS O PAINEL NÃO ABRE ──────────────────────────────────
# São as três que o código cobra na cara: faltando qualquer uma, toda tela
# mostra o erro com o nome da variável.

# Banco. Supabase → Project Settings → API.
# "Project URL" e a chave "service_role" (NÃO a anon).
# A service_role ignora o RLS e é lida SÓ no servidor; nunca a coloque numa
# variável NEXT_PUBLIC_ nem no navegador.
# Faltando: todas as telas mostram "Sem conexão com o banco".
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Endereço público do painel, sem barra no final.
# Ex.: https://painel.suaempresa.com.br
# É usado nos links de e-mail e nos redirecionamentos de login. Faltando:
# o login e os avisos por e-mail quebram.
APP_BASE_URL=


# ── NÍVEL 2 · SEM ESTAS VOCÊ NÃO ENTRA (ou entra inseguro) ─────────────────

# Senha do login de emergência (o campo "senha" da tela de entrada).
# Faltando: /api/login responde 500 e só sobra o login por e-mail.
DASHBOARD_PASSWORD=

# Segredo que assina o cookie de sessão e os links de convite da agenda.
# Gere um valor aleatório e guarde. Trocar ele desloga todo mundo.
# ATENÇÃO: se você deixar em branco, o sistema usa a DASHBOARD_PASSWORD para
# assinar — funciona, mas aí a sua senha vira a chave de assinatura. Preencha.
AUTH_SECRET=

# Nome da sua empresa. Aparece no cabeçalho, nos rodapés, nos e-mails e nos
# prompts da IA. Faltando: o painel escreve "Sua Empresa" (não quebra nada).
EMPRESA_NOME=


# ── NÍVEL 3 · CADA UMA LIGA UMA FUNÇÃO ─────────────────────────────────────
# O painel sobe sem elas. Cada bloco diz o que deixa de funcionar.

# Senha que o n8n usa para chamar as rotas /api/cron/*.
# O MESMO valor vai na credencial "Painel CRON" do n8n
# (header Authorization: Bearer <este valor>).
# Faltando: os crons respondem 503 — nada automático acontece (nem sequência
# de funil, nem lembrete de reunião, nem vigia de conexão).
CRON_SECRET=


# ── WHATSAPP (Evolution API) ───────────────────────────────────────────────
# Sem isto o painel LÊ as conversas mas não consegue RESPONDER, e a tela
# Conexão não mostra o QR code.

EVOLUTION_API_URL=
EVOLUTION_API_KEY=
# O nome da instância. Precisa ser IDÊNTICO em três lugares: aqui, no seu
# workflow do n8n e na coluna instancia_whatsapp da tabela vendedores.
EVOLUTION_INSTANCE=


# ── PONTE COM O ROBÔ (pausar/retomar) ──────────────────────────────────────
# É o que faz o botão "assumir a conversa" calar o robô por 24h.
# A URL é o webhook do workflow "Ponte" no n8n; o segredo é o mesmo que você
# colocou lá dentro. Veja PAINEL-INTEGRACAO.md.
# Faltando: o painel envia mensagem, mas o robô continua respondendo junto.
PAUSE_WEBHOOK_URL=
PAUSE_WEBHOOK_SECRET=
# Opcional. A URL de LEITURA do estado é deduzida da de cima (mesmo caminho,
# terminando em /painel-pausa-estado). Só preencha se a sua for diferente.
PAUSE_STATE_WEBHOOK_URL=


# ── E-MAIL (Resend) — opcional, mas recomendado ────────────────────────────
# Habilita o login por link no e-mail e o envio dos relatórios.
# ATENÇÃO: o Resend só envia de um domínio VERIFICADO na conta dele. Um
# remetente qualquer é recusado e o e-mail some sem aviso.
# Faltando: dá para entrar só pela senha, e os relatórios não saem.
RESEND_API_KEY=
EMAIL_REMETENTE="Sua Empresa <painel@suaempresa.com.br>"


# ── AVISOS OPERACIONAIS — recomendado ──────────────────────────────────────
# Quem recebe "o WhatsApp caiu", o resumo da agenda e o relatório de tráfego.
# Separe por vírgula. Vazio = ninguém é avisado (o painel segue funcionando).
ALERTAS_EMAIL=
ALERTAS_WHATSAPP=

# LEIA ISTO se você tem UM número só: o aviso de "WhatsApp caiu" sai POR UMA
# INSTÂNCIA da Evolution — e a que caiu é exatamente a que não consegue avisar.
# Com um número só, configure o ALERTAS_EMAIL acima: o e-mail é o único
# caminho que sobrevive à queda. Se você tiver um segundo número só para
# avisos, coloque a instância dele aqui.
EVOLUTION_INSTANCE_ALERTAS=


# ── INTELIGÊNCIA ARTIFICIAL — opcional ─────────────────────────────────────
# Resumo automático das conversas e o plano de ação da tela Prioridades.
# O Groq tem camada gratuita e é tentado primeiro; a OpenAI é a reserva.
# Faltando as duas: as telas funcionam, só não há resumo nem plano.
GROQ_API_KEY=
OPENAI_API_KEY=


# ── ANÚNCIOS (Meta Ads) — opcional ─────────────────────────────────────────
# Liga a tela de Tráfego (investimento, custo por lead, retorno).
# O token vem do Business Manager, com permissão de leitura de anúncios.
# Faltando: a tela de Tráfego mostra "não configurado" em vez de números.
META_ADS_ACCESS_TOKEN=
# Os ids das contas de anúncio, separados por vírgula (com ou sem "act_").
# Se você anuncia em mais de uma conta, liste TODAS — senão o investimento
# aparece menor do que é.
META_ADS_ACCOUNT_IDS=
# Alternativa de nome antigo, para uma conta só. Prefira o de cima.
META_ADS_ACCOUNT_ID=

# Filtro OPCIONAL por nome de campanha. Em branco (o padrão) = conta TODAS as
# campanhas. Se você nomeia suas campanhas de captação com uma marca comum
# (ex.: "leads"), coloque a palavra aqui para somar só elas.
# CUIDADO: com filtro preenchido, campanha cujo nome não tem a palavra é
# descartada em silêncio — e a tela mostra R$ 0,00 sem dar erro.
META_ADS_FILTRO_CAMPANHA=


# ── AJUSTES FINOS — opcional ───────────────────────────────────────────────

# Data em que sua operação começou (AAAA-MM-DD). É o piso da janela "Desde o
# início" nos relatórios. Sem isso, o painel usa os últimos 90 dias.
INICIO_PROJETO=
